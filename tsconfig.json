{
  "compilerOptions": {
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "jsx": "react",
    "jsxFactory": "React.createElement",
    "jsxFragmentFactory": "React.Fragment"
  },
  "include": ["plugins/**/*.ts", "plugins/**/*.tsx"],
  "exclude": ["node_modules", "plugins/**/node_modules", "plugins/**/dist", "plugins/**/lib"]
}
