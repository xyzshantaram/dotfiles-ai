[Unit]
Description=DeepSeek Harness web server (dsh web)
Documentation=https://github.com/deepseek-ai/deepseek-harness
StartLimitIntervalSec=0
PartOf=user-www.target
# The work profile routes Claude models through meridian.service. The unit
# declares the dependency so the stack comes up in order even when
# user-www.target starts dsh-web.service on its own. Drop both lines if you
# never use the meridian route.
After=meridian.service
Wants=meridian.service

[Service]
Type=simple
WorkingDirectory=%h

# dsh web serves on loopback only (--host 127.0.0.1). Caddy terminates TLS on
# 0.0.0.0:1337 and proxies here, so dsh web is never reachable from the LAN
# directly. The launcher rejects --host 0.0.0.0 by design
# (DSH/dsh-web-app/lib/startup.js: "0.0.0.0 is intentionally not supported
# yet for safety"), so loopback binding is the only option, exactly like the
# opencode-web.service pattern this mirrors.
# --trusted-host grants the /api browser-trust fence to the HTTPS origin the
# browser uses (potato.local:1337), the dsh analog of opencode's --cors.
# --no-open neutralizes the default browser handoff for headless runs.
# PATH is derived at runtime by a fish login shell rather than hardcoded, so
# the service picks up config.fish changes (fnm node bumps, dsh updates) on
# restart. `exec` is required: it replaces fish with dsh so dsh becomes MAINPID
# and systemd's signal delivery and Restart= track the real process.
ExecStart=/usr/bin/fish -l -c 'exec dsh web --host 127.0.0.1 --port 3080 --trusted-host potato.local:1337 --no-open'

Restart=always
RestartSec=5

[Install]
WantedBy=user-www.target
