{
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "micromark": "npm:micromark@4.0.2",
    "preact": "npm:preact@10.26.4",
    "preact-render-to-string": "npm:preact-render-to-string@6.6.2",
    "typed-htmx": "npm:typed-htmx@^0.3.1",
    "zx": "npm:zx@8.8.5",
    "playwright": "npm:playwright@1.57.0"
  },
  "tasks": {
    "check": "deno check --no-lock src/*.ts wizards/*.ts wizards/expense-split/*.ts desktop/*.ts wizardkit/*.ts wizardkit/examples/*.ts",
    "test": "deno test --no-lock --allow-read --allow-write --allow-env --allow-sys --allow-run tests/",
    "test:fixtures": "bash tests/run.sh",
    "dev": "deno run --no-lock -A",
    "desktop": "deno desktop --hmr wizardkit/examples/demo.ts"
  },
  "workspace": [
    "./desktop",
    "./wizard",
    "./wizardkit"
  ],
  "fmt": {
    "lineWidth": 100,
    "exclude": [
      "wizardkit/vendor",
      "state",
      "out",
      "desktop/dist",
      "tests/fixtures"
    ]
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "lint": {
    "exclude": [
      "wizardkit/vendor",
      "state",
      "out",
      "desktop/dist",
      "tests/fixtures"
    ]
  }
}
