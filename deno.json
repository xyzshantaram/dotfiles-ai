{
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    // Temporary. wizardkit is not on JSR yet, so this points the JSR
    // specifier at the local checkout. Delete this line once
    // @xyzshantaram/wizardkit is published. Every other dependency is
    // named in full inside the source, so this repository runs
    // straight from a raw GitHub URL with no import map.
    "jsr:@xyzshantaram/wizardkit@^0.1.0": "/home/sid/repos/wizardkit/src/mod.ts"
  },
  "tasks": {
    "check": "deno check --no-lock cli.ts src/*.ts wizards/*.ts wizards/expense-split/*.ts",
    "test": "deno test --no-lock --allow-read --allow-write --allow-env --allow-sys --allow-run tests/",
    "test:fixtures": "bash tests/run.sh",
    "dev": "deno run --no-lock -A"
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": [
      "state",
      "out",
      "tests/fixtures"
    ]
  },
  "lint": {
    "exclude": [
      "state",
      "out",
      "tests/fixtures"
    ],
    "rules": {
      // This repository runs straight from a raw GitHub URL. Deno does
      // not apply a local import map to a remote module, so a bare
      // specifier fails there with "not a dependency". Naming every
      // dependency in full inside the source is what makes the plain
      // one-command run work, so the rule that forbids it is off.
      "exclude": [
        "no-import-prefix"
      ]
    }
  }
}
