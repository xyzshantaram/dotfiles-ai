#!/usr/bin/env bash
#
# devtunnel — run a local dev server and expose it over HTTPS on the LAN at
# https://potato.local:<port>/, via the existing Caddy + local-CA + mDNS setup.
#
# Deliberately reuses the ONE hostname avahi actually publishes (potato.local
# — its own machine name) rather than minting a per-tunnel subdomain: avahi
# only auto-answers mDNS queries for its literal hostname, never arbitrary
# names beneath it (that needs a root-owned /etc/avahi/hosts entry per name,
# which isn't rootless). Different tunnels are told apart by port, not name —
# <name> is purely a local tracking label (state dir, Caddyfile markers,
# `devtunnel list`), it never appears in the URL.
#
# Never touches sudo/firewalld itself. It only ever binds Caddy's external
# side to a port inside PORT_RANGE_LO..PORT_RANGE_HI, which must already be
# opened once, permanently, out of band:
#
#   sudo firewall-cmd --permanent --add-port=1338-1360/tcp
#   sudo firewall-cmd --reload
#
# Usage:
#   devtunnel start <name> <port> -- <command...>
#       Run <command...> in the background, wait for it to start listening
#       on 127.0.0.1:<port>, add a Caddy vhost potato.local:<ext-port> ->
#       127.0.0.1:<port>, restart Caddy, print the HTTPS URL.
#
#   devtunnel stop <name>
#   devtunnel stop --all
#       Kill the tracked process, remove its Caddy vhost, restart Caddy.
#
#   devtunnel restart <name>
#   devtunnel restart --all
#       Stop then start the tracked tunnel again with its original command
#       and port (same external URL, unless that port got taken meanwhile).
#
#   devtunnel list
#       Show all tracked tunnels: name, ports, URL, running/dead, log path.
#
#   devtunnel logs <name> [-f]
#       Print (or follow, with -f) the tunnel's command output.
#
#   devtunnel -h | --help
#
# Examples:
#   devtunnel start tile-studio 5173 -- npx vite --host 0.0.0.0 --port 5173 --strictPort
#   devtunnel stop tile-studio
#   devtunnel restart tile-studio
#   devtunnel list

set -euo pipefail

PORT_RANGE_LO=1338
PORT_RANGE_HI=1360

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/devtunnel"
CADDYFILE="${HOME}/.config/caddy/Caddyfile"
CADDY_SERVICE="caddy.service"
SHARED_HOST="potato.local"
LOCK_FILE="${STATE_DIR}/.lock"

usage() {
  sed -n '2,48p' "$0" | sed 's/^# \{0,1\}//'
}

die() {
  echo "devtunnel: $*" >&2
  exit 1
}

require_name() {
  local name="$1"
  [[ "$name" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]] \
    || die "invalid name '$name' — must be a valid DNS label (lowercase letters, digits, hyphens, not starting/ending with a hyphen)"
}

require_port() {
  local port="$1"
  [[ "$port" =~ ^[0-9]+$ ]] && (( port >= 1 && port <= 65535 )) \
    || die "invalid port '$port' — must be an integer 1-65535"
}

tunnel_dir() { echo "${STATE_DIR}/$1"; }

is_pid_alive() {
  local pid="$1"
  [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

port_in_use() {
  local port="$1"
  ss -ltn 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${port}\$"
}

# Every currently-tracked (alive or dead) tunnel's external Caddy port, one per line.
tracked_ext_ports() {
  local dir
  for dir in "${STATE_DIR}"/*/; do
    [[ -f "${dir}ext_port" ]] && cat "${dir}ext_port"
  done 2>/dev/null
}

pick_free_ext_port() {
  local used p
  used="$(tracked_ext_ports)"
  for ((p = PORT_RANGE_LO; p <= PORT_RANGE_HI; p++)); do
    if ! grep -qx "$p" <<<"$used" && ! port_in_use "$p"; then
      echo "$p"
      return 0
    fi
  done
  die "no free port in range ${PORT_RANGE_LO}-${PORT_RANGE_HI} (all in use — stop an unused tunnel, or widen the range with: sudo firewall-cmd --permanent --add-port=<new-range>/tcp && sudo firewall-cmd --reload, then bump PORT_RANGE_HI in this script)"
}

caddy_block_begin() { echo "# devtunnel:${1}:start"; }
caddy_block_end()   { echo "# devtunnel:${1}:end"; }

# Removes any existing block for $1 from the Caddyfile (idempotent).
remove_caddy_block() {
  local name="$1"
  [[ -f "$CADDYFILE" ]] || return 0
  local begin end
  begin="$(caddy_block_begin "$name")"
  end="$(caddy_block_end "$name")"
  awk -v b="$begin" -v e="$end" '
    $0 == b { skip = 1; next }
    $0 == e { skip = 0; next }
    !skip { print }
  ' "$CADDYFILE" > "${CADDYFILE}.tmp"
  mv "${CADDYFILE}.tmp" "$CADDYFILE"
}

append_caddy_block() {
  local name="$1" ext_port="$2" local_port="$3"
  {
    caddy_block_begin "$name"
    echo "${SHARED_HOST}:${ext_port} {"
    echo "	tls internal"
    echo "	reverse_proxy 127.0.0.1:${local_port}"
    echo "}"
    caddy_block_end "$name"
  } >> "$CADDYFILE"
}

restart_caddy_or_rollback() {
  local backup="$1"
  if ! caddy validate --config "$CADDYFILE" >/dev/null 2>&1; then
    cp "$backup" "$CADDYFILE"
    die "Caddyfile failed validation, rolled back. Run 'caddy validate --config $CADDYFILE' to see why."
  fi
  systemctl --user restart "$CADDY_SERVICE"
}

_launch_and_register() {
  local name="$1" local_port="$2" ext_port="$3" cwd="$4"
  shift 4
  local dir
  dir="$(tunnel_dir "$name")"
  mkdir -p "$dir"

  printf '%s\n' "$*" > "${dir}/cmd"
  echo "$local_port" > "${dir}/local_port"
  echo "$ext_port"   > "${dir}/ext_port"
  printf '%s\n' "$cwd" > "${dir}/cwd"

  if [[ -n "$cwd" ]]; then
    DEVTUNNEL_START_CWD="$cwd" setsid bash -c 'cd "$DEVTUNNEL_START_CWD" && exec bash -c "$0"' "$*" >"${dir}/log" 2>&1 &
  else
    setsid bash -c "$*" >"${dir}/log" 2>&1 &
  fi
  local pid=$!
  echo "$pid" > "${dir}/pid"

  echo "devtunnel: started '$name' (pid $pid), waiting for 127.0.0.1:${local_port} ..." >&2
  local waited=0
  while ! port_in_use "$local_port"; do
    if ! is_pid_alive "$pid"; then
      echo "devtunnel: command exited before binding to port ${local_port}. Log:" >&2
      cat "${dir}/log" >&2 || true
      rm -rf "$dir"
      exit 1
    fi
    if (( waited >= 30 )); then
      echo "devtunnel: timed out after 30s waiting for 127.0.0.1:${local_port}. It may still come up — check 'devtunnel logs $name'." >&2
      break
    fi
    sleep 1
    ((waited++)) || true
  done

  {
    flock -x 200
    remove_caddy_block "$name"
    cp "$CADDYFILE" "${dir}/Caddyfile.bak"
    append_caddy_block "$name" "$ext_port" "$local_port"
    restart_caddy_or_rollback "${dir}/Caddyfile.bak"
  } 200>"$LOCK_FILE"

  echo
  echo "  https://${SHARED_HOST}:${ext_port}/"
  echo
  echo "devtunnel: logs: devtunnel logs $name   |   stop: devtunnel stop $name"
}

cmd_start() {
  (( $# >= 3 )) || die "usage: devtunnel start <name> <port> -- <command...>"
  local name="$1" local_port="$2"
  shift 2
  [[ "${1:-}" == "--" ]] || die "expected -- before the command"
  shift
  (( $# >= 1 )) || die "no command given after --"

  require_name "$name"
  require_port "$local_port"
  mkdir -p "$STATE_DIR"

  local dir
  dir="$(tunnel_dir "$name")"
  if [[ -d "$dir" ]]; then
    local old_pid
    old_pid="$(cat "${dir}/pid" 2>/dev/null || true)"
    if is_pid_alive "$old_pid"; then
      die "tunnel '$name' is already running (pid $old_pid) — run 'devtunnel stop $name' first"
    fi
    rm -rf "$dir"
  fi

  local ext_port
  ext_port="$(pick_free_ext_port)"

  _launch_and_register "$name" "$local_port" "$ext_port" "$(pwd)" "$@"
}

cmd_stop_one() {
  local name="$1"
  local dir
  dir="$(tunnel_dir "$name")"
  [[ -d "$dir" ]] || die "no tracked tunnel named '$name' (see: devtunnel list)"

  local pid
  pid="$(cat "${dir}/pid" 2>/dev/null || true)"
  if is_pid_alive "$pid"; then
    kill -TERM "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
    for _ in 1 2 3 4 5; do
      is_pid_alive "$pid" || break
      sleep 1
    done
    is_pid_alive "$pid" && { kill -KILL "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true; }
  fi

  {
    flock -x 200
    remove_caddy_block "$name"
    cp "$CADDYFILE" "${dir}/Caddyfile.bak.stop"
    restart_caddy_or_rollback "${dir}/Caddyfile.bak.stop"
  } 200>"$LOCK_FILE"

  rm -rf "$dir"
  echo "devtunnel: stopped '$name'"
}

cmd_stop() {
  (( $# >= 1 )) || die "usage: devtunnel stop <name> | devtunnel stop --all"
  if [[ "$1" == "--all" ]]; then
    local any=0
    local dir name
    for dir in "${STATE_DIR}"/*/; do
      [[ -d "$dir" ]] || continue
      name="$(basename "$dir")"
      cmd_stop_one "$name"
      any=1
    done
    (( any )) || echo "devtunnel: nothing to stop"
  else
    require_name "$1"
    cmd_stop_one "$1"
  fi
}

cmd_restart_one() {
  local name="$1"
  local dir
  dir="$(tunnel_dir "$name")"
  [[ -d "$dir" ]] || die "no tracked tunnel named '$name' (see: devtunnel list)"

  local local_port ext_port cmd cwd
  local_port="$(cat "${dir}/local_port" 2>/dev/null || true)"
  ext_port="$(cat "${dir}/ext_port" 2>/dev/null || true)"
  cmd="$(cat "${dir}/cmd" 2>/dev/null || true)"
  cwd="$(cat "${dir}/cwd" 2>/dev/null || true)"
  [[ -n "$local_port" && -n "$ext_port" && -n "$cmd" ]] \
    || die "tunnel '$name' has incomplete state, cannot restart (see: devtunnel list)"

  cmd_stop_one "$name"

  if port_in_use "$ext_port"; then
    echo "devtunnel: external port ${ext_port} was taken while restarting, picking a new one" >&2
    ext_port="$(pick_free_ext_port)"
  fi

  _launch_and_register "$name" "$local_port" "$ext_port" "$cwd" "$cmd"
}

cmd_restart() {
  (( $# >= 1 )) || die "usage: devtunnel restart <name> | devtunnel restart --all"
  if [[ "$1" == "--all" ]]; then
    local any=0
    local dir name
    for dir in "${STATE_DIR}"/*/; do
      [[ -d "$dir" ]] || continue
      name="$(basename "$dir")"
      cmd_restart_one "$name"
      any=1
    done
    (( any )) || echo "devtunnel: nothing to restart"
  else
    require_name "$1"
    cmd_restart_one "$1"
  fi
}

cmd_list() {
  mkdir -p "$STATE_DIR"
  local dir name pid local_port ext_port status
  local found=0
  printf '%-20s %-8s %-6s %-6s %-45s %s\n' "NAME" "STATUS" "PID" "LPORT" "URL" "LOG"
  for dir in "${STATE_DIR}"/*/; do
    [[ -d "$dir" ]] || continue
    name="$(basename "$dir")"
    pid="$(cat "${dir}/pid" 2>/dev/null || echo -)"
    local_port="$(cat "${dir}/local_port" 2>/dev/null || echo -)"
    ext_port="$(cat "${dir}/ext_port" 2>/dev/null || echo -)"
    if is_pid_alive "$pid"; then status="running"; else status="dead"; fi
    printf '%-20s %-8s %-6s %-6s %-45s %s\n' \
      "$name" "$status" "$pid" "$local_port" \
      "https://${SHARED_HOST}:${ext_port}/" "${dir}log"
    found=1
  done
  (( found )) || echo "(no tracked tunnels)"
}

cmd_logs() {
  (( $# >= 1 )) || die "usage: devtunnel logs <name> [-f]"
  local name="$1"; shift
  require_name "$name"
  local dir
  dir="$(tunnel_dir "$name")"
  [[ -f "${dir}/log" ]] || die "no tracked tunnel named '$name' (see: devtunnel list)"
  if [[ "${1:-}" == "-f" ]]; then
    tail -f "${dir}/log"
  else
    cat "${dir}/log"
  fi
}

main() {
  local sub="${1:-}"
  case "$sub" in
    start)   shift; cmd_start "$@" ;;
    stop)    shift; cmd_stop "$@" ;;
    restart) shift; cmd_restart "$@" ;;
    list)    shift; cmd_list "$@" ;;
    logs)    shift; cmd_logs "$@" ;;
    -h|--help|"") usage ;;
    *) die "unknown command '$sub' (see: devtunnel --help)" ;;
  esac
}

main "$@"
