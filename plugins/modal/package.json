{
  "name": "modal",
  "version": "0.1.0",
  "type": "module",
  "description": "One app-wide modal host in shell.overlay, published as window.__dshModal__ so any plugin or bundle can open a PluginModal without bundling its own copy.",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "license": "MIT"
}
